.DS_Store

# Downloaded Unicode data used by tools/generate_identifier.py
DerivedCoreProperties.txt

# Actual compiler output written next to a golden fixture on a mismatch, for
# diffing against the checked-in `.js.expected`. Regenerated each failing run.
test/fixtures/**/*.js.actual
# Compiled output of the library's .sl sources (e.g. Std.js from Std.sl) --
# regenerated by the compiler; only the .sl source is checked in.
libraries/**/*.js
